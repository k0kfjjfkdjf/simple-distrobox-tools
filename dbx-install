#!/usr/bin/env bash
# dbx-install — ставит пакеты других дистрибутивов в контейнеры Distrobox
# и сразу выносит их ярлыки в меню хоста (через dbx-sync).
#
# Использование:
#   dbx-install файл.deb            → в контейнер для .deb (по умолчанию ubuntu)
#   dbx-install файл.rpm            → в контейнер для .rpm (по умолчанию fedora)
#   dbx-install файл.pkg.tar.zst    → в контейнер arch (пакет Arch Linux)
#   dbx-install vlc gimp            → пакеты по имени из репозитория (ubuntu)
#   dbx-install -c fedora vlc       → по имени, но в указанный контейнер
#   dbx-install -r vlc              → удалить пакет (ярлык тоже исчезнет)
#
# Параметры:
#   -c ИМЯ    контейнер (создаётся автоматически, если его нет)
#   -i ОБРАЗ  образ для нового контейнера (например debian:13, opensuse/tumbleweed)
#   -y        не спрашивать подтверждения у пакетного менеджера
#   -r        удалить пакеты вместо установки
#
# Настройки по умолчанию можно переопределить в ~/.config/dbx-tools/config:
#   DEB_BOX=ubuntu  DEB_IMAGE=ubuntu:24.04  RPM_BOX=fedora  RPM_IMAGE=fedora:latest
#   ARCH_BOX=arch   ARCH_IMAGE=docker.io/library/archlinux:latest
set -euo pipefail
# shellcheck source=dbx-lib
. "$(dirname "$(readlink -f "$0")")/dbx-lib"

die() { printf 'dbx-install: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

BOX=""; IMAGE=""; YES=0; REMOVE=0
while getopts "c:i:yrh" opt; do
  case "$opt" in
    c) BOX="$OPTARG" ;;
    i) IMAGE="$OPTARG" ;;
    y) YES=1 ;;
    r) REMOVE=1 ;;
    h) usage 0 ;;
    *) usage 2 ;;
  esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || usage 2
if [ -n "${CONTAINER_ID:-}" ] || [ -e /run/.containerenv ]; then
  die "вы сейчас ВНУТРИ контейнера «${CONTAINER_ID:-?}». Выйдите командой exit и запустите снова на хосте."
fi
command -v distrobox >/dev/null || die "distrobox не установлен (Arch: sudo pacman -S distrobox podman; SteamOS 3.5+: уже встроен; иначе см. README)"


# Что ставим: .deb-файлы, .rpm-файлы или имена пакетов
KIND=name; ARGS=()
for a in "$@"; do
  case "$a" in
    *.deb|*.rpm|*.pkg.tar.zst|*.pkg.tar.xz|*.pkg.tar.gz)
      [ "$REMOVE" = 1 ] && die "для удаления укажите имя пакета, а не файл"
      case "$a" in *.deb) k=deb ;; *.rpm) k=rpm ;; *) k=pkg ;; esac
      [ "$KIND" = name ] || [ "$KIND" = "$k" ] || die "нельзя смешивать пакеты разных форматов в одной команде"
      KIND="$k"
      [ -f "$a" ] || die "файл не найден: $a"
      p="$(readlink -f "$a")"
      # Домашний каталог виден в контейнере по тому же пути, остальное — через /run/host
      case "$p" in "$HOME"/*) ;; *) p="/run/host$p" ;; esac
      ARGS+=("$p") ;;
    *) [ "$KIND" = name ] || die "нельзя смешивать файлы и имена пакетов"
       ARGS+=("$a") ;;
  esac
done

# Выбор контейнера и образа
case "$KIND" in
  deb) BOX="${BOX:-$DEB_BOX}"; IMAGE="${IMAGE:-$DEB_IMAGE}" ;;
  rpm) BOX="${BOX:-$RPM_BOX}"; IMAGE="${IMAGE:-$RPM_IMAGE}" ;;
  pkg) BOX="${BOX:-$ARCH_BOX}"; IMAGE="${IMAGE:-$ARCH_IMAGE}" ;;
  name)
    BOX="${BOX:-$DEB_BOX}"
    if [ -z "$IMAGE" ]; then
      case "$BOX" in
        "$RPM_BOX") IMAGE="$RPM_IMAGE" ;; "$ARCH_BOX") IMAGE="$ARCH_IMAGE" ;; *) IMAGE="$DEB_IMAGE" ;;
      esac
    fi ;;
esac

# Создать контейнер, если его ещё нет
if ! box_exists "$BOX"; then
  [ "$REMOVE" = 1 ] && die "контейнера «$BOX» нет — удалять нечего"
  create_box "$BOX" "$IMAGE"
fi

# Какой пакетный менеджер внутри
PM="$(box_pm "$BOX")" || die "в контейнере «$BOX» не найден apt, dnf, pacman или zypper"
case "$KIND:$PM" in
  deb:apt|rpm:dnf|rpm:zypper|pkg:pacman|name:*) ;;
  *) die ".$KIND нельзя поставить через $PM (контейнер «$BOX»). Укажите другой через -c" ;;
esac

# Команда для пакетного менеджера
OP=$([ "$REMOVE" = 1 ] && echo remove || echo install)
YF=""
case "$PM" in
  apt)
    [ "$YES" = 1 ] && YF="-y"
    if [ "$REMOVE" = 1 ]; then CMD="sudo apt-get remove $YF \"\$@\""
    else CMD="sudo apt-get update && sudo apt-get install $YF \"\$@\""; fi ;;
  dnf)
    [ "$YES" = 1 ] && YF="-y"
    CMD="sudo dnf $OP $YF \"\$@\"" ;;
  zypper)
    [ "$YES" = 1 ] && YF="--non-interactive"
    CMD="sudo zypper $YF $OP \"\$@\"" ;;
  pacman)
    [ "$YES" = 1 ] && YF="--noconfirm"
    if [ "$REMOVE" = 1 ]; then CMD="sudo pacman -Rns $YF \"\$@\""
    elif [ "$KIND" = pkg ]; then CMD="sudo pacman -U $YF \"\$@\""
    else CMD="sudo pacman -Syu --needed $YF \"\$@\""; fi ;;
esac

ACTION=$([ "$REMOVE" = 1 ] && echo "Удаляю" || echo "Устанавливаю")
echo "==> $ACTION в «$BOX» ($PM): ${ARGS[*]}"
distrobox enter -n "$BOX" -- bash -c "$CMD" bash "${ARGS[@]}"

echo "==> Обновляю ярлыки в меню"
dbx_sync "$BOX"
